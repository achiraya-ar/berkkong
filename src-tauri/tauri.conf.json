{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BerkKong",
  "mainBinaryName": "BerkKong",
  "version": "1.26.1116",
  "identifier": "com.berkkong",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BerkKong — ระบบเบิกของ",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#fbf7f1",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "ระบบบันทึกการเบิกพัสดุและเวชภัณฑ์ที่มิใช่ยา",
    "longDescription": "BerkKong — โปรแกรมบันทึกการเบิกพัสดุสำนักงานและเวชภัณฑ์ที่มิใช่ยา สำหรับหน่วยงานในโรงพยาบาล พิมพ์ใบเบิก 2 รูปแบบ ตั้งค่าผู้ลงนามแยกตามประเภท และเก็บประวัติไว้ในเครื่อง โดยไม่ติดตามจำนวนคงเหลือ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
